#!/bin/sh

set -eu

if [ -z "${HOME-}" ]; then
  echo "ai-config: HOME must be set before launching" >&2
  exit 1
fi

TRUSTED_PATH=${PATH-}
SYSTEM_PATH=/usr/bin:/bin
PATH=$SYSTEM_PATH
REALPATH=$(command -v realpath)
[ -x "$REALPATH" ] || { echo "ai-config: system realpath helper is required" >&2; exit 1; }
SCRIPT_PATH=$($REALPATH "$0")
case "$SCRIPT_PATH" in
  /*) ;;
  *) echo "ai-config: launcher path must resolve to an absolute path" >&2; exit 1 ;;
esac
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd -P)
SOURCE_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd -P)

if ! BUN=$(PATH="$TRUSTED_PATH" command -v bun 2>/dev/null); then
  echo "ai-config: Bun 1.4.0 is required" >&2
  exit 1
fi
case "$BUN" in
  /*) ;;
  *) echo "ai-config: Bun executable must resolve to an absolute path" >&2; exit 1 ;;
esac
BUN_DIR=${BUN%/*}
BUN_NAME=${BUN##*/}
BUN_DIR=$(CDPATH= cd -- "$BUN_DIR" && pwd -P)
BUN="$BUN_DIR/$BUN_NAME"
[ -x "$BUN" ] || { echo "ai-config: Bun executable is not executable" >&2; exit 1; }
BUN=$($REALPATH "$BUN")
[ -x "$BUN" ] || { echo "ai-config: Bun executable is not executable" >&2; exit 1; }

if [ "$(/usr/bin/env -i PATH="$SYSTEM_PATH" HOME="$HOME" "$BUN" --no-env-file --no-install --config="$SOURCE_ROOT/bunfig.toml" --version)" != "1.4.0" ]; then
  echo "ai-config: exactly Bun 1.4.0 is required" >&2
  exit 1
fi

exec /usr/bin/env -i PATH="$TRUSTED_PATH" HOME="$HOME" TMPDIR="${TMPDIR:-/tmp}" XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}" XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}" XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}" "$BUN" --no-env-file --no-install --config="$SOURCE_ROOT/bunfig.toml" "$SOURCE_ROOT/bin/ai-config-lifecycle.mjs" "$@"
